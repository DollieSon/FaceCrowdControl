# Copy to server-rs/.env and edit. Read by the server (`cargo run`), docker compose,
# and the extension's `npm run config -- --env ../server-rs/.env`.
# Keep comments on their own lines.

# Port the server listens on.
PORT=3000

# Address the server listens on. 127.0.0.1 = only this PC can reach it.
BIND_ADDRESS=127.0.0.1

# Database. Pick one; nothing else changes when you switch.
#   SQLite (default, no setup): a file, created if missing.
DATABASE_URL=sqlite://data/fcc.db
#   Postgres: use its own database, not the v1 server's.
# DATABASE_URL=postgres://user:password@localhost:5432/facecrowdcontrol_v2
# To keep your data when switching:
#   cargo run -- copy-db --from sqlite://data/fcc.db --to postgres://user:password@localhost:5432/facecrowdcontrol_v2

# Chat commands that trigger game actions.
GAMES_CONFIG=games.toml

# Optional: if set, game mods must connect to ws://.../ws/game?token=<this>.
# GAME_TOKEN=

# Viewers who chatted in the last POINTS_ACTIVE_WINDOW_SECS earn POINTS_PER_TICK
# every POINTS_INTERVAL_SECS.
POINTS_INTERVAL_SECS=180
POINTS_PER_TICK=1
POINTS_ACTIVE_WINDOW_SECS=1800

# Seconds a game has to answer an action before it's refunded.
ACTION_TIMEOUT_SECS=60

# Log detail: e.g. fcc_server=debug,tower_http=debug
# RUST_LOG=fcc_server=info

# ---- docker compose only ----
# Database URL inside the container (the db service is reachable as "db").
#   SQLite (default): COMPOSE_DATABASE_URL=sqlite://data/fcc.db
#   Postgres: run `docker compose --profile postgres up` and set
# COMPOSE_DATABASE_URL=postgres://user:password@db:5432/facecrowdcontrol_v2
PGUSER=user
PGPASSWORD=password
PGDATABASE=facecrowdcontrol_v2
