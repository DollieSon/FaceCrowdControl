# Copy to server/.env and edit. Read by:
#   - docker compose (port mapping, database, Isaac folder)
#   - `npm start` / `npm run dev` in server/
#   - `npm run config` in extension/ (writes the server URL into the extension)
# Keep comments on their own lines; inline comments aren't read the same way by every tool.

# Port the server listens on.
PORT=3000

# Address the server is published on. 127.0.0.1 = only this PC can reach it.
BIND_ADDRESS=127.0.0.1

# Full URL the extension sends chat to. Optional; defaults to http://BIND_ADDRESS:PORT.
# EXTENSION_SERVER_URL=http://127.0.0.1:3000

# Database. Inside docker compose PGHOST is always "db"; this value is for `npm start` outside Docker.
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=facecrowdcontrol

# Folder the Isaac mod reads from (mounted into the container at /app/data).
ISAAC_MOD_DATA_DIR=C:/Manual_D/Steam/steamapps/common/The Binding of Isaac Rebirth/mods/FBCrowdControl/data
